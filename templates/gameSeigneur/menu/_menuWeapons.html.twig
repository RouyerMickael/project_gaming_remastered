            <div id="spanGandalf" width="400" height="300" class="position-relative" onclick="nextStep('gandalf')">
                <img id="gandalfImage" width="400" height="300" src="{{asset('assets/gameSeigneur/assetsGame/menus/gandalf.jpeg')}}">
                <br/>
                <video id="gandalfVideo" class="overTopVideo" type="video/mp4" autoplay loop muted>
                    <source src="{{asset('assets/gameSeigneur/assetsGame/menus/gandalf_all_fights_comp.mp4')}}" type="video/mp4">
                </video>
            </div>
            <br/>
            <h6>Ganfalf</h6>
        </div>
        <div class="col">
            <div id="spanGimli" width="400" height="300" class="position-relative" onclick="nextStep('gimli')">
                <img id="gimliImage" width="400" height="300" src="{{asset('assets/gameSeigneur/assetsGame/menus/gimli.jpg')}}">
                <br/>
                <video id="gimliVideo" class="overTopVideo" type="video/mp4" autoplay loop muted>
                    <source src="{{asset('assets/gameSeigneur/assetsGame/menus/gimli_all_fights.mp4')}}" type="video/mp4">
                </video>
            </div>
            <br/>
            <h6>Gimli</h6>
            <br/>
        </div>
        <div class="col">
            <div  id="spanLegolas" width="400" height="300" class="position-relative" onclick="nextStep('legolas')">
                <img width="400" height="300" src="{{asset('assets/gameSeigneur/assetsGame/menus/legolas.jpg')}}">
                <br/>
                <video id="legolasVideo" class="overTopVideo" type="video/mp4" autoplay loop muted>
