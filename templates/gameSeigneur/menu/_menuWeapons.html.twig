</div>


<script>

    $(document).ready(function() {
        //random start videos
        $('#gandalfVideo').on('loadedmetadata', function() {
            this.currentTime = Math.random() * this.duration;
        });
        $('#gimliVideo').on('loadedmetadata', function() {
            this.currentTime = Math.random() * this.duration;
        });
        $('#legolasVideo').on('loadedmetadata', function() {
            this.currentTime = Math.random() * this.duration;
        });
    });

    //hover videos
    $("#spanGandalf").hover(function(){
        $("#gandalfVideo").show()
        }, function(){
            $("#gandalfVideo").hide()
        }
    )
    $("#spanGimli").hover(function(){
        $("#gimliVideo").show()
        }, function(){
            $("#gimliVideo").hide()
        }
    )
    $("#spanLegolas").hover(function(){
        $("#legolasVideo").show()
        }, function(){
            $("#legolasVideo").hide()
        }
    )

</script>
