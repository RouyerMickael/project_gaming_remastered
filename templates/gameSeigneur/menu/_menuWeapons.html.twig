<style>
    .overTopVideo {
        position: absolute;
        cursor: pointer;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: black;
        display: none;
        width: 100% ;
        height: 100%
    }
</style>


